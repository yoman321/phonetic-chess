# This file documents env vars used by the app.
# Copy the relevant lines into backend/.env (which is gitignored).
#
# Compose loads backend/.env into the backend container at runtime via env_file.
# DATABASE_URL in backend/.env is ignored — compose overrides it in
# docker-compose.yml to point at the `db` service.

# Required: Groq API key for the LLM that picks moves.
# Get one at https://console.groq.com/keys (free tier, no credit card).
GROQ_API_KEY=gsk_replace_me

# Optional overrides. Defaults are in backend/controller_operations/llm.py.
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=3
# Thinking mode for reasoning models: "none" (default) or "default".
# LLM_REASONING_EFFORT=none
